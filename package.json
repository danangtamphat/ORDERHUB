{
  "name": "orderhub",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "db:migrate:prod": "node server/dist/db/migrate.js",
    "db:seed:prod": "node server/dist/db/seed.js",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
